// Canonical positive for registered-field multiplication folding.
//
// Phase 6 reclassified this from expected divergence after VeIR canonical
// differential mode started running `felt-combine,dce`, matching LLZK's
// removal of now-dead input constants.

function.def @fold_mul() -> !felt.type<"babybear"> {
  %a = felt.const 6 : !felt.type<"babybear">
  %b = felt.const 7 : !felt.type<"babybear">
  %c = felt.mul %a, %b : !felt.type<"babybear">, !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
