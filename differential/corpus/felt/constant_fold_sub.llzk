// Canonical positive for registered-field subtraction folding.
//
// Phase 6 reclassified this from expected divergence after VeIR canonical
// differential mode started running `felt-combine,dce`, matching LLZK's
// removal of now-dead input constants.

function.def @fold_sub() -> !felt.type<"babybear"> {
  %a = felt.const 9 : !felt.type<"babybear">
  %b = felt.const 4 : !felt.type<"babybear">
  %c = felt.sub %a, %b : !felt.type<"babybear">, !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
