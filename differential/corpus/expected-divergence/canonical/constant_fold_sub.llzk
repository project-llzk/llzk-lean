// EXPECTED-DIVERGE in canonicalization mode.
//
// Both tools fold the subtraction to 5, but LLZK also erases the now-dead
// input constants while VeIR `felt-combine` does not run DCE.

function.def @fold_sub() -> !felt.type<"babybear"> {
  %a = felt.const 9 : !felt.type<"babybear">
  %b = felt.const 4 : !felt.type<"babybear">
  %c = felt.sub %a, %b : !felt.type<"babybear">, !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
