// EXPECTED-DIVERGE in canonicalization mode.
//
// LLZK reduces the folded registered-field negation modulo babybear
// (`-5` becomes `2013265916`), while VeIR currently emits the raw integer.

function.def @fold_neg() -> !felt.type<"babybear"> {
  %a = felt.const 5 : !felt.type<"babybear">
  %c = felt.neg %a : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
