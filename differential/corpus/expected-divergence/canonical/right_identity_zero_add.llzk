// EXPECTED-DIVERGE in canonicalization mode.
//
// VeIR's `right_identity_zero_add` rewrites `felt.add x 0` to `x`.
// LLZK currently leaves this non-constant add in place under `--canonicalize`.

function.def @add_zero(%x: !felt.type<"babybear">) -> !felt.type<"babybear"> {
  %zero = felt.const 0 : !felt.type<"babybear">
  %y = felt.add %x, %zero : !felt.type<"babybear">, !felt.type<"babybear">
  function.return %y : !felt.type<"babybear">
}
