// EXPECTED-DIVERGE in canonicalization mode.
//
// VeIR's `assoc_const_fold_add` rewrites `(x + c1) + c2` to
// `x + (c1 + c2)`. LLZK currently leaves the nested add chain in place.

function.def @assoc_add(%x: !felt.type<"babybear">) -> !felt.type<"babybear"> {
  %c1 = felt.const 2 : !felt.type<"babybear">
  %c2 = felt.const 3 : !felt.type<"babybear">
  %inner = felt.add %x, %c1 : !felt.type<"babybear">, !felt.type<"babybear">
  %outer = felt.add %inner, %c2 : !felt.type<"babybear">, !felt.type<"babybear">
  function.return %outer : !felt.type<"babybear">
}
